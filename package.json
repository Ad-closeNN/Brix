{
  "name": "brixpackager",
  "version": "0.1.0",
  "description": "Brix is a lightweight CLI tool that packages web apps into standalone Windows executables using native WebView2. Features include custom protocol asset serving, embedded backend support, SHA-256 verification, and installer generation.",
  "main": "src/cli.js",
  "bin": {
    "brix": "src/cli.js",
    "brixpack": "src/cli.js"
  },
  "scripts": {
    "build": "node src/cli.js build",
    "test": "cargo test --manifest-path src/stub/Cargo.toml",
    "prepublishOnly": "node scripts/check-stub.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "bin/stub.exe",
    "branding/",
    "package.json",
    "README.md",
    "Documentation.md",
    "syntax.md",
    "LICENSE",
    "icon.ico"
  ],
  "author": {
    "name": "HaadiAli",
    "url": "https://github.com/haadiali242"
  },
  "homepage": "https://github.com/haadiali242/Brix",
  "license": "MIT",
  "keywords": [
    "desktop-app",
    "webview2",
    "packaging",
    "cli",
    "bundler",
    "lightweight",
    "brix"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.12",
    "resedit": "^1.7.1"
  }
}